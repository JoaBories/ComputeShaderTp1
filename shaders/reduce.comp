#version 430 core
layout(local_size_x = 1024) in;
layout(std430, binding = 0) buffer Vector { float values[]; };
uniform uint size;

void main() {
    
    uint groupIndex = gl_GlobalInvocationID.x;

    /*
    for (uint stride = 1; stride < size; stride *= 2)
    {
        for (uint index = groupIndex; index < size; index += 1024)
        {
            if ((index & (2 * stride - 1)) == 0)
            {
                values[index] += values[index + stride];
            }
        }
        barrier();
    }
    */
    
    for (uint stride = size / 2; stride >= 1; stride /= 2) 
    {
        for (uint index = groupIndex; index < stride; index += 1024) 
        {
            values[index] += values[index + stride];
        }
        barrier();
    }
}