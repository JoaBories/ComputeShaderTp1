#version 430 core
layout(local_size_x = 1024) in;
layout(std430, binding = 0) readonly buffer currentVector { float current[]; };
layout(std430, binding = 1) writeonly buffer nextVector { float next[]; };
uniform uint size;

shared float partial[1024];

void main() {
    uint globalId = gl_GlobalInvocationID.x;
    uint localId = gl_LocalInvocationID.x;

    partial[localId] = globalId < size ? current[globalId] : 0;
    barrier();

    for (uint stride = 1024 / 2; stride > 0; stride /= 2)
    {
        partial[localId] += localId < stride ? partial[localId + stride] : 0;
        barrier();
    }
    
    if (localId == 0)
    {
        next[gl_WorkGroupID.x] = partial[0];
    }
}